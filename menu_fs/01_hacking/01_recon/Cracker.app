{
  "name": "Cracker",
  "module": "bad_stuff.recon.cracker",
  "icon": "recon.png",
  "sort_priority": 5,
  "description": "Offline WPA2 password cracker. Loads a captured .pcap or .pcapng handshake file and runs hashcat against a wordlist. Requires a valid handshake \u2014 use Handshake or PMKID Grab to capture one first.",
  "usage": "UP/DOWN: select file  CENTER: start crack  KEY3: exit\nResults shown on screen when finished."
