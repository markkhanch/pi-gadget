{
  "name": "Probe Sniffer",
  "module": "bad_stuff.recon.probe_sniffer",
  "icon": "recon.png",
  "sort_priority": 4,
  "description": "Listens for Wi-Fi probe requests broadcast by nearby devices. Every phone or laptop automatically searches for known networks \u2014 this app captures those searches and shows MAC addresses and SSIDs.",
  "usage": "CENTER: start/stop capture  KEY3: exit\nRuns in background \u2014 device keeps sniffing after you leave."
}