{
  "name": "MAC Changer",
  "module": "bad_stuff.wireless.mac_changer",
  "icon": "app_default.png",
  "sort_priority": 1,
  "description": "Changes the MAC address of the wireless adapter (wlan1). Use a random MAC to anonymize your device on a network, or set a specific one to spoof another device's identity.",
