{
  "name": "Payloads",
  "module": "bad_stuff.usb.payload",
  "icon": "app_default.png",
  "sort_priority": 1,
  "description": "Executes HID (keyboard) payloads when the Pi is plugged into a target computer via USB. The Pi appears as a USB keyboard and types the payload automatically. Requires USB gadget mode enabled.",
  "usage": "UP/DOWN: select payload  CENTER: execute  KEY3: exit\nPayload files in Files \u203a payloads/"
