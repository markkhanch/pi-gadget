{
  "name": "USB Mode",
  "module": "settings.usb_mode",
  "icon": "app_default.png",
  "sort_priority": 8,
  "description": "Switch the USB port between different gadget modes: HID keyboard (for payloads), USB storage, or serial console. Requires reconnecting the USB cable after switching.",
  "usage": "UP/DOWN: select mode  CENTER: apply  KEY3: exit"
}